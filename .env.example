# ============================================================
# Telegram Bot
# ============================================================
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# ============================================================
# Local Bot API (нужен для файлов > 50 МБ, до 2 ГБ)
# API_ID и API_HASH получить на https://my.telegram.org
# Если не используется — оставить пустым, бот работает напрямую
# ============================================================
API_ID=
API_HASH=
BOT_API_PORT=8085

# ============================================================
# PostgreSQL
# ============================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bot_4_upscaler
DB_USER=bot_4_upscaler
DB_PASSWORD=changeme_strong_password

# ============================================================
# Администраторы (через запятую, без пробелов)
# ============================================================
ADMIN_IDS=123456789,987654321
ADMIN_USERNAME=your_admin_username

# ============================================================
# Лимиты обработки
# ============================================================
MAX_INPUT_MB=10
RESTORE_MAX_INPUT_MB=10
PROCESS_TIMEOUT_SEC=120
USER_RATE_LIMIT_SEC=60

# ============================================================
# HuggingFace Spaces (опционально, но желательно для приватных Spaces)
# Получить на https://huggingface.co/settings/tokens
# ============================================================
HF_API_TOKEN=
SPACE_TIMEOUT_SEC=120
